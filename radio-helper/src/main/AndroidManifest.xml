<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Legacy radio-toggle capability (works because targetSdk = 28). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <!-- Wi-Fi toggle on Android 12+ / OEMs (e.g. ColorOS): the legacy
         targetSdk-28 setWifiEnabled() path alone is no longer honored (BT
         legacy enable() still is). Tasker Settings declares this and has the
         user grant it once via ADB:
           adb shell pm grant dev.superdrop.radiohelper.debug \
               android.permission.WRITE_SECURE_SETTINGS
         (.debug suffix on debug builds; survives reboot, lost on reinstall.)
         protectionLevel includes "development" so `pm grant` works. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Only apps signed with the same key (Super Drop) may bind the
         radio service. The in-process self-test activity is unaffected. -->
    <permission
        android:name="dev.superdrop.radiohelper.permission.BIND_RADIO"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="false"
        android:label="Super Drop Radio Helper">

        <!-- Standalone self-test: install this APK alone and tap the
             buttons to confirm the OEM (e.g. ColorOS) honours the
             targetSdk-28 radio toggle before wiring the main app. -->
        <activity
            android:name=".SelfTestActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bound by :app via Messenger to flip radios on an NFC tap. -->
        <service
            android:name=".RadioService"
            android:exported="true"
            android:permission="dev.superdrop.radiohelper.permission.BIND_RADIO" />
    </application>
</manifest>
