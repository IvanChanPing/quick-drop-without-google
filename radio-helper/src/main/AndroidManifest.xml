<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="rikka.shizuku.provider, rikka.shizuku.api, rikka.shizuku.shared, rikka.shizuku.aidl" />

    <!-- Shizuku = silent Wi-Fi fallback (shell-UID `svc wifi`) when the OEM
         clamps setWifiEnabled even with WRITE_SECURE_SETTINGS. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Legacy radio-toggle capability (works because targetSdk = 28). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <!-- NOTE: WRITE_SECURE_SETTINGS is intentionally NOT declared. It does
         NOT affect WifiManager.setWifiEnabled() — that API's only exemptions
         are Device-Owner / Profile-Owner / system apps (per the AOSP doc).
         Silent Wi-Fi on a clamping OEM (ColorOS) = Shizuku only; else panel. -->

    <!-- Only apps signed with the same key (Super Drop) may bind the
         radio service. The in-process self-test activity is unaffected. -->
    <permission
        android:name="dev.superdrop.radiohelper.permission.BIND_RADIO"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="false"
        android:label="Super Drop Radio Helper">

        <!-- Standalone self-test: install this APK alone and tap the
             buttons to confirm the OEM (e.g. ColorOS) honours the
             targetSdk-28 radio toggle before wiring the main app. -->
        <activity
            android:name=".SelfTestActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bound by :app via Messenger to flip radios on an NFC tap. -->
        <service
            android:name=".RadioService"
            android:exported="true"
            android:permission="dev.superdrop.radiohelper.permission.BIND_RADIO" />

        <!-- Shizuku provider (required by the Shizuku API to talk to the
             Shizuku/Sui service). The RadioShellService user service is NOT
             declared here — Shizuku spawns it via app_process. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
