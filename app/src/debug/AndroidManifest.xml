<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".debug.BleFastScanProbeActivity"
            android:exported="true"
            android:label="BLE Fast Scan Probe">
            <intent-filter>
                <action android:name="dev.superdrop.debug.BLE_FAST_SCAN_PROBE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".debug.ConsentPreviewActivity"
            android:exported="true"
            android:label="Consent Notification Preview">
            <intent-filter>
                <action android:name="dev.superdrop.debug.CONSENT_PREVIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Debug-only: launcher icon "SuperDrop ADB-WiFi Test" to exercise the
             self-ADB Wi-Fi loop (pair → self-grant WSS → svc wifi) on-device. -->
        <activity
            android:name=".debug.AdbWifiTestActivity"
            android:exported="true"
            android:label="SuperDrop ADB-WiFi Test">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="dev.superdrop.debug.ADB_WIFI_TEST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
