<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout for ConsentTrampolineActivity (#22, Phase 2 OShare receive sheet).

  Restructured from the old centered dialog into an OShare-style bottom
  sheet (see dev.superdrop.ui.sheet.DraggableSheetLayout), mirroring the
  sender's activity_send.xml shape:

  Shape (back to front):
    1. consent_sheet_root — transparent, match_parent FrameLayout. Hosted
       by the translucent Theme.SuperDrop.ReceiveSheet so the app /
       launcher / lock screen behind shows through a soft 0.2 dim.
    2. consent_sheet_scrim — full-bleed transparent scrim that consumes
       taps outside the card; the activity wires it to a slide-down
       dismiss.
    3. consent_sheet — a bottom-anchored DraggableSheetLayout: a rounded
       ~28dp light surface that slides up on entrance and drags down to
       dismiss. It hosts the inner content frame.
    4. consent_root — the fixed-height inner content frame. Holds the
       five sequential panels; ConsentTrampolineActivity flips their
       visibility via TransitionManager.beginDelayedTransition (it looks
       this id up as the transition scene root) so the sheet resizes
       smoothly between states.

  The five panels are unchanged in id / role from the old layout so the
  activity's findViewById logic and its accept→receiving→completed/failed
  state machine keep working verbatim. New in Phase 2:
    * consent_waiting_panel — "Ready to receive / waiting for sender",
      shown when the sheet is opened by the QS tile with no pending
      consent.
    * the receiving panel's progress is a RoundedProgressBar (pill track
      + animated blue fill, OShare look) instead of the old
      CircularProgressIndicator.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/consent_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!--
      Full-bleed transparent scrim. Sits behind the sheet and consumes
      taps outside the card; ConsentTrampolineActivity wires its click
      to a slide-down dismiss. Drawn first so the sheet floats on top.
    -->
    <View
        android:id="@+id/consent_sheet_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!--
      Bottom-anchored sheet card. The fixed 480dp content height of the
      old centered card is kept on the inner content frame so state-to-
      state geometry stays consistent; the sheet itself wraps that plus
      its rounded-surface padding.
    -->
    <dev.superdrop.ui.sheet.DraggableSheetLayout
        android:id="@+id/consent_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/send_sheet_background"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp">

        <!--
          Inner content host. Layered, fixed 480dp tall so the sheet
          never changes size between consent / waiting / receiving /
          completed / failed panels. `consent_root` is the transition
          scene root the activity animates between panels. clipToOutline
          keeps the blurred completion backdrop within the rounded card.
        -->
        <FrameLayout
            android:id="@+id/consent_root"
            android:layout_width="match_parent"
            android:layout_height="480dp"
            android:clipChildren="true"
            android:clipToOutline="true">

            <!--
              Blurred backdrop for the completed state. Mirrors the
              sender's blur pair: the ImageView fills the frame via
              centerCrop, and the white sheet on top dampens the blur so
              the foreground content stays readable. Both default `gone`;
              ConsentTrampolineActivity flips them on once the receive
              completes and a bitmap is sampled from MediaStore.
            -->
            <ImageView
                android:id="@+id/consent_card_blur"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:ignore="ContentDescription" />

            <View
                android:id="@+id/consent_card_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/card_blur_overlay"
                android:visibility="gone" />

            <!-- Consent state — initial (when a transfer is pending). -->
            <LinearLayout
                android:id="@+id/consent_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/consent_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.AppCompat.Headline"
                    android:textStyle="bold"
                    tools:text="Pixel 8 wants to share images" />

                <!-- `consent_subtitle` is intentionally `gone`; the id is
                     kept stable for legacy lookups (the activity has the
                     view id) so a future reinstatement needs no churn. -->
                <TextView
                    android:id="@+id/consent_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                    android:visibility="gone"
                    tools:text="3 files (12.4 MB)" />

                <TextView
                    android:id="@+id/consent_pin_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="@string/consent_pin_label"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body2" />

                <TextView
                    android:id="@+id/consent_pin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:letterSpacing="0.4"
                    android:textAppearance="@style/TextAppearance.AppCompat.Display1"
                    android:textStyle="bold"
                    tools:text="1234" />

                <TextView
                    android:id="@+id/consent_files_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="@string/consent_files_label"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body2" />

                <LinearLayout
                    android:id="@+id/consent_files_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <!--
                  Decline / Accept row. Decline (leading, gray) +
                  Accept (trailing, blue accent). Each button sizes to
                  wrap_content and the row is centered as a group so the
                  pair recenters as labels grow / shrink with locale.
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/consent_reject_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minWidth="140dp"
                        android:text="@string/consent_button_reject"
                        android:textAlignment="center"
                        android:textColor="?android:attr/textColorSecondary" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/consent_accept_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minWidth="140dp"
                        android:text="@string/consent_button_accept"
                        android:textAlignment="center"
                        android:textColor="@color/brand_primary" />

                </LinearLayout>

            </LinearLayout>

            <!-- Waiting state (Phase 2) — opened by the QS tile with no
                 pending transfer. Swaps to consent_panel in place when an
                 incoming transfer arrives while the sheet is foreground. -->
            <LinearLayout
                android:id="@+id/consent_waiting_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/consent_waiting_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/consent_state_waiting_title"
                    android:textAppearance="@style/TextAppearance.AppCompat.Headline"
                    android:textStyle="bold" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/consent_waiting_spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:indeterminate="true"
                    app:indicatorSize="56dp"
                    app:trackThickness="5dp" />

                <TextView
                    android:id="@+id/consent_waiting_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="@string/consent_state_waiting_body"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1" />

            </LinearLayout>

            <!-- Receiving state — RoundedProgressBar (OShare pill fill). -->
            <LinearLayout
                android:id="@+id/consent_receiving_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/consent_receiving_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/consent_state_receiving"
                    android:textAppearance="@style/TextAppearance.AppCompat.Headline"
                    android:textStyle="bold" />

                <dev.superdrop.ui.sheet.RoundedProgressBar
                    android:id="@+id/consent_receiving_progress"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp" />

                <TextView
                    android:id="@+id/consent_receiving_progress_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                    android:textStyle="bold"
                    tools:text="42%" />

                <TextView
                    android:id="@+id/consent_receiving_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                    tools:text="12 MB / 100 MB" />

            </LinearLayout>

            <!-- Completed state. -->
            <LinearLayout
                android:id="@+id/consent_completed_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/consent_completed_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/consent_state_completed"
                    android:textAppearance="@style/TextAppearance.AppCompat.Headline"
                    android:textStyle="bold" />

                <!-- Polaroid wrapper around the completed-state preview.
                     ConsentTrampolineActivity toggles the WRAPPER's
                     visibility once the MediaStore lookup resolves. -->
                <FrameLayout
                    android:id="@+id/consent_completed_preview_card"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/photo_card_background"
                    android:elevation="4dp"
                    android:padding="6dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/consent_completed_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/main_send_preview_photo_description"
                        android:scaleType="centerCrop" />

                </FrameLayout>

                <TextView
                    android:id="@+id/consent_completed_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                    tools:text="1 file received" />

                <!--
                  Close / View image row centered as a group. Both buttons
                  are FrameLayout-wrapped TextViews (the wrapper carries the
                  frosted background + click; the inner wrap_content TextView
                  centers via FrameLayout layout_gravity) — see the long
                  rationale in git history; this sidesteps the AppCompat
                  button text-centering bug on the Bridge theme.

                  consent_completed_view_button (the FrameLayout id) starts
                  hidden; the activity reveals it (and the spacer) only after
                  the MediaStore lookup resolves to an image Uri.
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/consent_completed_close_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/btn_frosted_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="48dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:paddingHorizontal="24dp"
                            android:paddingVertical="12dp"
                            android:text="@string/consent_state_close"
                            android:textAppearance="@style/TextAppearance.Bada.Button"
                            android:textColor="?android:attr/textColorPrimary" />

                    </FrameLayout>

                    <Space
                        android:id="@+id/consent_completed_button_gap"
                        android:layout_width="12dp"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <FrameLayout
                        android:id="@+id/consent_completed_view_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/btn_frosted_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="48dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:paddingHorizontal="24dp"
                            android:paddingVertical="12dp"
                            android:text="@string/consent_state_view_image"
                            android:textAppearance="@style/TextAppearance.Bada.Button"
                            android:textColor="?android:attr/textColorPrimary" />

                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Failed / cancelled / rejected state. -->
            <LinearLayout
                android:id="@+id/consent_failed_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/consent_failed_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/consent_state_failed"
                    android:textAppearance="@style/TextAppearance.AppCompat.Headline"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/consent_failed_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                    android:visibility="gone"
                    tools:text="UKEY2 BAD_VERSION" />

                <Button
                    android:id="@+id/consent_failed_close_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/consent_state_close" />

            </LinearLayout>

        </FrameLayout>

    </dev.superdrop.ui.sheet.DraggableSheetLayout>

</FrameLayout>
