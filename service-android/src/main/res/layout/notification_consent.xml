<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom heads-up content for the incoming-transfer consent notification.
  Used via NotificationCompat.DecoratedCustomViewStyle so the system frame
  (small icon + app name + timestamp) stays native while this controls the
  body: a title, a one-line summary, and the two consent buttons pinned to
  OPPOSITE edges (Decline far-left, Accept far-right) and recolored. Bound +
  wired with PendingIntents at runtime in ConsentNotification.build().
  Only RemoteViews-supported layouts/widgets are used (LinearLayout,
  RelativeLayout, TextView, Button).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/notif_consent_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notif_consent_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="13sp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/notif_consent_decline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:background="@drawable/notif_btn_decline_bg"
            android:minWidth="104dp"
            android:textAllCaps="false"
            android:textColor="#FFD93025"
            android:textStyle="bold" />

        <Button
            android:id="@+id/notif_consent_accept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:background="@drawable/notif_btn_accept_bg"
            android:minWidth="104dp"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold" />
    </RelativeLayout>
</LinearLayout>
